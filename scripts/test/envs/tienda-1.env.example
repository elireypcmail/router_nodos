# Copiar a tienda-1.env y completar tras provisioning en hub-ui.
# Tienda sugerida para simular COMPRAS (costo bajo en sinv vs otras tiendas).

NODO_ID=REEMPLAZAR_UUID_TRAS_PROVISIONING
NODO_NOMBRE=Tienda prueba 1 (compra)
NODO_ROLE=slave
NODO_API_TOKEN=REEMPLAZAR_TOKEN_DEL_BUNDLE

HUB_BASE_URL=http://servidor:3000
HUB_API_KEY=dev-internal-key-cambiar
HUB_PUSH_ENABLED=true
HUEY_ENABLED=true
HUEY_DB_PATH=./data/huey.sqlite
MYSQL_HOST=mysql-tienda-1
MYSQL_PORT=3306
MYSQL_USER=multishop
MYSQL_PASSWORD=multishop
MYSQL_DATABASE=mi_base_historica

# Opcional: pull de eventos hub→tienda
# HUB_PULL_ENABLED=true
